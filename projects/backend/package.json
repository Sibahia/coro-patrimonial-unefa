{
  "name": "coro-patrimonial-unefa-backend",
  "version": "1.0.0",
  "description": "API REST y Socket.IO del Coro Patrimonial UNEFA",
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "node --watch index.js",
    "dev:memory": "node scripts/local-api-server.js",
    "start": "node index.js",
