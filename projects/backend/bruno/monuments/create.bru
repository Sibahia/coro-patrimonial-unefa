meta {
  name: Crear monumento
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/monuments
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "title": "Monumento Bruno",
    "code": "MON-BRUNO-{{$timestamp}}",
    "category": "Civil",
    "constructionType": "Mampostería"
  }
}

tests {
  test("HTTP 201", function() {
    expect(res.getStatus()).to.equal(201);
  });
}
