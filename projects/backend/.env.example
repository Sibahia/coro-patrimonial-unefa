# Copia este archivo a .env y reemplaza los valores de ejemplo.
# .env está ignorado por Git: nunca subas credenciales reales.

APP_NAME=coro-patrimonial-unefa
NODE_ENV=development
PORT=3500

# MongoDB (local o Atlas). En producción usa una URI mongodb+srv://
MONGO_URI=mongodb://127.0.0.1:27017/coro_patrimonial_unefa

# JWT: genera secretos largos y aleatorios (p. ej. GUID) y nunca los versiones
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Usuarios semilla creados por npm run seed
SEED_PASSWORD=change-me-seed-password

# Cookie del refresh token (true en producción con HTTPS)
COOKIE_NAME=refreshToken
COOKIE_SECURE=false

# Orígenes permitidos por CORS (separados por coma)
CORS_ORIGINS=http://localhost:4200,http://localhost:5173

# Subidas
UPLOAD_MAX_SIZE_MB=10
