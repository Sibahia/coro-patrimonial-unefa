              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"firstName\":\"Postman\",\"lastName\":\"Coro\",\"voiceType\":\"soprano\",\"role\":\"Corista\"}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/members"
          }
        },
        {
          "name": "Listar integrantes públicos",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/members?search=Postman"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 y solo activos', function () { pm.response.to.have.status(200); pm.expect(pm.response.json().data.items.every(function (i) { return i.isActive === true; })).to.be.true; });"
                ]
              }
            }
          ]
        },
        {
          "name": "Dar de baja integrante",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"firstName\":\"Postman\",\"lastName\":\"Coro\",\"isActive\":false}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/members/{{memberId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', function () { pm.response.to.have.status(200); pm.expect(pm.response.json().data.isActive).to.be.false; });"
                ]
              }
            }
          ]
        },
        {
          "name": "Baja no visible con query",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/members?search=Postman&isActive=false"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Integrante dado de baja no aparece', function () {",
                  "  var id = pm.environment.get('memberId');",
                  "  var items = pm.response.json().data.items;",
                  "  pm.expect(items.some(function (i) { return i._id === id; })).to.be.false;",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
